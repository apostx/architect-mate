{
  "name": "architect-mate",
  "version": "0.0.0",
  "private": true,
  "description": "A minimalist, visual system design and solution architecture practice game.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apostx/architect-mate.git"
  },
  "homepage": "https://apostx.github.io/architect-mate/",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solution-validator": "https://codeload.github.com/apostx/solution-validator/tar.gz/refs/tags/v0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
