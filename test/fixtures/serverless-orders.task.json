{
  "schemaVersion": 1,
  "id": "serverless-orders",
  "title": "Serverless orders",
  "packs": ["core", "aws"],
  "provided": [{ "id": "users", "type": "core.internet", "locked": true }],
  "requirements": [
    {
      "id": "r1",
      "type": "reachable",
      "description": "Users on the internet can write to a data store.",
      "from": { "id": "users" },
      "to": { "category": "data-store" },
      "action": "write"
    },
    {
      "id": "r2",
      "type": "not-reachable",
      "description": "No object storage is directly accessible from the internet.",
      "from": { "id": "users" },
      "to": { "type": "aws.s3" }
    },
    {
      "id": "r3",
      "type": "uses",
      "description": "The solution uses AWS Lambda.",
      "select": { "type": "aws.lambda" }
    }
  ]
}
