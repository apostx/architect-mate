{
  "schemaVersion": 1,
  "packs": ["core", "aws"],
  "components": [
    {
      "id": "customers",
      "type": "core.internet",
      "label": "Customers"
    },
    {
      "id": "orders-api",
      "type": "aws.api-gateway",
      "label": "Orders API",
      "properties": {
        "endpoint": "public",
        "routes": [
          {
            "path": "/orders",
            "target": "place-order"
          }
        ]
      }
    },
    {
      "id": "place-order",
      "type": "aws.lambda",
      "label": "Place order",
      "properties": {
        "permissions": [
          {
            "resource": "orders",
            "access": "write"
          }
        ]
      }
    },
    {
      "id": "orders",
      "type": "aws.s3",
      "label": "Orders bucket",
      "roles": ["order-store"],
      "properties": {
        "publicAccess": false
      }
    }
  ],
  "intents": [
    {
      "id": "customers-to-orders-api",
      "from": "customers",
      "to": "orders-api",
      "action": "invoke",
      "port": "https"
    },
    {
      "id": "orders-api-to-place-order",
      "from": "orders-api",
      "to": "place-order",
      "action": "invoke"
    },
    {
      "id": "place-order-to-orders",
      "from": "place-order",
      "to": "orders",
      "action": "write"
    }
  ],
  "meta": {
    "note": "Alternative: the orders are stored in a private S3 bucket.",
    "expected": {
      "status": "evaluated",
      "verdict": "pass",
      "requirements": {
        "place-orders": "pass",
        "https-api": "pass",
        "private-orders": "pass",
        "uses-lambda": "pass"
      }
    }
  }
}
